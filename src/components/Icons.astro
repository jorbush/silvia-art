---
interface Props {
  name:
    | 'full-frame'
    | 'grid'
    | 'sets'
    | 'share'
    | 'tag'
    | 'medium'
    | 'theme-system'
    | 'theme-light'
    | 'theme-dark'
    | 'mail'
    | 'github'
    | 'copy'
    | 'admin';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

{
  name === 'full-frame' && (
    <svg
      width="28"
      height="24"
      viewBox="0 0 28 24"
      fill="none"
      stroke="currentColor"
      class={className}
      aria-hidden="true"
    >
      <rect x="6" y="7" width="16" height="10" rx="1" stroke-width="1.25" />
      <line x1="6" y1="4.75" x2="22" y2="4.75" stroke-width="1" />
      <line x1="6" y1="19.25" x2="22" y2="19.25" stroke-width="1" />
    </svg>
  )
}
{
  name === 'grid' && (
    <svg
      width="28"
      height="24"
      viewBox="0 0 28 24"
      fill="none"
      stroke="currentColor"
      class={className}
      aria-hidden="true"
    >
      <rect x="7" y="5" width="3.5" height="3.5" rx="0.5" stroke-width="1" />
      <rect x="12.25" y="5" width="3.5" height="3.5" rx="0.5" stroke-width="1" />
      <rect x="17.5" y="5" width="3.5" height="3.5" rx="0.5" stroke-width="1" />
      <rect x="7" y="10.25" width="3.5" height="3.5" rx="0.5" stroke-width="1" />
      <rect x="12.25" y="10.25" width="3.5" height="3.5" rx="0.5" stroke-width="1" />
      <rect x="17.5" y="10.25" width="3.5" height="3.5" rx="0.5" stroke-width="1" />
      <rect x="7" y="15.5" width="3.5" height="3.5" rx="0.5" stroke-width="1" />
      <rect x="12.25" y="15.5" width="3.5" height="3.5" rx="0.5" stroke-width="1" />
      <rect x="17.5" y="15.5" width="3.5" height="3.5" rx="0.5" stroke-width="1" />
    </svg>
  )
}
{
  name === 'sets' && (
    <svg
      width="28"
      height="24"
      viewBox="0 0 28 24"
      fill="none"
      stroke="currentColor"
      class={className}
      aria-hidden="true"
    >
      <rect x="7" y="6" width="14" height="3" rx="0.75" stroke-width="1.2" />
      <rect x="7" y="11" width="14" height="3" rx="0.75" stroke-width="1.2" />
      <rect x="7" y="16" width="9" height="3" rx="0.75" stroke-width="1.2" />
    </svg>
  )
}
{
  name === 'share' && (
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
    >
      <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
      <polyline points="16 6 12 2 8 6" />
      <line x1="12" y1="2" x2="12" y2="15" />
    </svg>
  )
}
{
  name === 'tag' && (
    <svg
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="currentColor"
      class={className}
      aria-hidden="true"
    >
      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82zM7 7a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" />
    </svg>
  )
}
{
  name === 'medium' && (
    <svg
      width="13"
      height="13"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
    >
      <path d="M12 19l7-7 3 3-7 7-3-3z" />
      <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
      <path d="M2 2l7.586 7.586" />
      <circle cx="11" cy="11" r="2" />
    </svg>
  )
}
{
  name === 'theme-system' && (
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class={className}
      aria-hidden="true"
    >
