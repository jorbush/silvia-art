---
interface Props {
  title?: string;
}

const { title } = Astro.props;
const hasIcon = Astro.slots.has('icon');
---

<div class="space-y-1">
  {
    (title || hasIcon) && (
      <div class="text-main flex items-center gap-1.5 font-sans text-xs font-medium tracking-wider uppercase">
        {hasIcon && (
          <span class="w-[1rem] text-center">
            <slot name="icon" />
          </span>
        )}
        {title && <span>{title}</span>}
      </div>
    )
  }
  <div class="space-y-0.5 pl-[1px] text-sm">
    <slot />
  </div>
</div>
