---
import { ADMIN_CMS_URL, REPO_AUTHOR_URL } from '@/lib/settings';
import SiteGrid from './SiteGrid.astro';
import Icons from './Icons.astro';

interface Props {
  contactEmail: string;
}

const { contactEmail } = Astro.props;
---

<footer transition:persist="site-footer">
  <SiteGrid>
    <div class="text-dim my-8 flex flex-wrap items-center gap-y-3">
      <div class="flex flex-grow flex-wrap items-center gap-x-4 gap-y-1">
        <a
          href={ADMIN_CMS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 hover:text-gray-600 dark:hover:text-gray-300"
        >
          <Icons name="admin" class="translate-y-[-0.5px]" />
          <span>Admin</span>
        </a>
        <span class="inline-flex items-center gap-2 whitespace-nowrap">
          <span class="hidden sm:inline-block">Contact:</span>
          <a
            href={`mailto:${contactEmail}`}
            class="flex items-center gap-1 text-black hover:underline dark:text-white"
          >
            <Icons name="mail" class="xs:inline-block hidden translate-y-[0.5px]" />
            <span class="hidden sm:inline-block">{contactEmail}</span>
            <span class="inline-block sm:hidden">Contact</span>
          </a>
        </span>
        <span class="inline-flex items-center gap-2 whitespace-nowrap">
          <span class="hidden sm:inline-block">Developed by</span>
          <a
            href={REPO_AUTHOR_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1 text-black hover:underline dark:text-white"
          >
            <Icons name="github" class="xs:inline-block hidden translate-y-[0.5px]" />
            <span>Jordi</span>
          </a>
        </span>
      </div>

      <div
        role="group"
        aria-label="Theme switcher"
        class="inline-flex h-[32px] overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-black [&>*:not(:first-child)]:border-l [&>*:not(:first-child)]:border-gray-200 dark:[&>*:not(:first-child)]:border-gray-800"
      >
        <button
          type="button"
          data-theme-value="system"
          aria-label="System theme"
          class="text-dim min-h-0 rounded-none border-0 px-2.5 py-1 shadow-none hover:bg-gray-100/70 dark:hover:bg-gray-900/70"
        >
          <Icons name="theme-system" />
        </button>
        <button
          type="button"
          data-theme-value="light"
          aria-label="Light theme"
          class="text-dim min-h-0 rounded-none border-0 px-2.5 py-1 shadow-none hover:bg-gray-100/70 dark:hover:bg-gray-900/70"
        >
          <Icons name="theme-light" />
        </button>
        <button
          type="button"
          data-theme-value="dark"
          aria-label="Dark theme"
          class="text-dim min-h-0 rounded-none border-0 px-2.5 py-1 shadow-none hover:bg-gray-100/70 dark:hover:bg-gray-900/70"
        >
          <Icons name="theme-dark" />
        </button>
      </div>
    </div>
  </SiteGrid>
</footer>
