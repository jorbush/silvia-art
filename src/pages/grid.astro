---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteGrid from '@/components/SiteGrid.astro';
import PaintingGrid from '@/components/PaintingGrid.astro';
import PaintingSidebar from '@/components/PaintingSidebar.astro';
import { getSettings, getUniqueMediums, getUniqueTags, loadPaintings } from '@/lib/paintings';

const paintings = loadPaintings();
const settings = getSettings();
const tags = getUniqueTags(paintings);
const mediums = getUniqueMediums(paintings);
---

<BaseLayout title="Grid" description={settings.siteDescription}>
  {
    paintings.length > 0 ? (
      <SiteGrid sideHiddenOnMobile>
        <PaintingGrid paintings={paintings} aspectRatio={settings.gridAspectRatio} />
        <div slot="side" class="sticky top-4 space-y-4">
          <PaintingSidebar paintings={paintings} tags={tags} mediums={mediums} />
        </div>
      </SiteGrid>
    ) : (
      <SiteGrid>
        <div class="text-medium rounded-lg border border-gray-200 p-8 text-center dark:border-gray-800">
          No paintings published yet.
        </div>
      </SiteGrid>
    )
  }
</BaseLayout>
