---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteGrid from '@/components/SiteGrid.astro';
import PaintingGrid from '@/components/PaintingGrid.astro';
import {
  getDateRangeForPaintings,
  getSettings,
  getUniqueMediums,
  loadPaintings,
  paintingQuantityText,
  type Painting,
} from '@/lib/paintings';
import { pathForMediumShare } from '@/lib/paths';
import Icons from '@/components/Icons.astro';

export function getStaticPaths() {
  const paintings = loadPaintings();
  const mediums = getUniqueMediums(paintings);

  return mediums.map(({ slug, medium }) => ({
    params: { medium: slug },
    props: {
      mediumLabel: medium,
      mediumSlug: slug,
      paintings: paintings.filter((p) => p.mediumSlug === slug),
    },
  }));
}

interface Props {
  mediumLabel: string;
  mediumSlug: string;
  paintings: Painting[];
}

const { mediumLabel, mediumSlug, paintings } = Astro.props;
const settings = getSettings();
const { description: dateRangeDesc } = getDateRangeForPaintings(paintings);
---

<BaseLayout
  title={`Medium: ${mediumLabel}`}
  description={`${paintingQuantityText(paintings.length, false)} in ${mediumLabel}`}
  ogImage={`/medium/${encodeURIComponent(mediumSlug)}/og.png`}
>
  <SiteGrid>
    <div class="mt-4 space-y-8">
      <div
        class="flex flex-wrap items-baseline justify-between gap-2 border-b border-gray-200 pb-3 dark:border-gray-800"
      >
        <div class="flex items-center gap-2">
          <Icons name="medium" class="text-icon h-3.5 w-3.5" />
          <span class="font-bold uppercase">{mediumLabel}</span>
          <span class="text-medium text-sm uppercase">
            {paintingQuantityText(paintings.length)}
            {dateRangeDesc}
          </span>
        </div>
        <a href={pathForMediumShare(mediumSlug)} class="text-dim hover:text-main text-xs uppercase">
          Share medium
        </a>
      </div>

      <PaintingGrid
        paintings={paintings}
        medium={mediumSlug}
        aspectRatio={settings.gridAspectRatio}
      />
    </div>
  </SiteGrid>
</BaseLayout>
