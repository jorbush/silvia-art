---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteGrid from '@/components/SiteGrid.astro';
import PaintingSidebar from '@/components/PaintingSidebar.astro';
import { getSettings, getUniqueMediums, getUniqueTags, loadPaintings } from '@/lib/paintings';

const paintings = loadPaintings();
const settings = getSettings();
const tags = getUniqueTags(paintings);
const mediums = getUniqueMediums(paintings);
---

<BaseLayout title="Sets" description={settings.siteDescription}>
  <SiteGrid>
    <div
      class="rounded-lg border border-gray-200 bg-gray-50/70 p-4 dark:border-gray-800 dark:bg-gray-950/60"
    >
      <div class="space-y-4 p-2 text-base">
        <PaintingSidebar paintings={paintings} tags={tags} mediums={mediums} />
      </div>
    </div>
  </SiteGrid>
</BaseLayout>

<script>
  import { navigate } from 'astro:transitions/client';

  document.addEventListener('astro:page-load', () => {
    if (window.location.pathname.startsWith('/sets') && window.innerWidth >= 768) {
      navigate('/grid');
    }
  });
</script>
